<main class="min-h-[calc(100vh-100px)] flex items-center justify-center px-4">
  <div
    class="relative bg-card w-full flex flex-col items-start p-10 border-1 max-h-full max-w-xl rounded-xl gap-[20px]"
  >
    <div class="flex flex-col gap-[8px]">
      <h2 class="text-primary-text uppercase text-xs font-[600]">{{ eyebrow }}</h2>
      <h1 class="font-[600] text-3xl">{{ title }}</h1>
      <p class="text-muted-foreground">{{ description }}</p>
    </div>
    {{{ await $slots.main() }}}
  </div>
</main>
