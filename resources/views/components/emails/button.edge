{{--
  CTA: td colorido + <a> com padding. Funciona até no Outlook.
  <button> não é estilizável em e-mail, por isso o botão é um link.

  Props: url, text
--}}

@let(url = $props.get('url', '#'))
@let(text = $props.get('text', ''))

<tr>
  <td style="padding-bottom: 28px;">
    <table role="presentation" cellpadding="0" cellspacing="0" border="0">
      <tr>
        <td bgcolor="#0e7490" style="background-color: #0e7490; border-radius: 8px;">
          <a href="{{ url }}"
            style="display: inline-block; padding: 14px 28px; font-family: -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 15px; font-weight: 600; line-height: 20px; color: #ffffff; text-decoration: none; border-radius: 8px;">
            {{ text }}
          </a>
        </td>
      </tr>
    </table>
  </td>
</tr>
