{{--
  Rodapé do cartão: o endereço em texto, para quem tem o botão bloqueado pelo cliente.

  Props: url, text
--}}

@let(url = $props.get('url', '#'))
@let(text = $props.get('text', 'Se o botão não funcionar, copie e cole este endereço no navegador:'))

<tr>
  <td
    style="font-family: -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 12px; line-height: 18px; color: #556b72; padding-top: 20px;">
    {{ text }}<br />
    <a href="{{ url }}" style="color: #0e7490; text-decoration: underline; word-break: break-all;">{{ url }}</a>
  </td>
</tr>
