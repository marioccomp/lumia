{{--
  Título e subtítulo no topo do cartão.

  Props: title, subtitle (o subtítulo é opcional)
--}}

@let(title = $props.get('title', ''))
@let(subtitle = $props.get('subtitle', ''))

<tr>
  <td class="h1"
    style="font-family: -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 24px; line-height: 32px; font-weight: 600; color: #111c21; padding-bottom: 16px;">
    {{ title }}
  </td>
</tr>

@if(subtitle)
  <tr>
    <td
      style="font-family: -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 15px; line-height: 23px; color: #111c21; padding-bottom: 24px;">
      {{ subtitle }}
    </td>
  </tr>
@end
