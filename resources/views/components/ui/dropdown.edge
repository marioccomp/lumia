<div
  class="relative"
  x-data="{ open: false }"
  @click.outside="open = false"
  @keydown.escape.stop.prevent="open = false; $refs.trigger.focus()"
>
  <button
    type="button"
    x-ref="trigger"
    aria-label="{{ $props.get('label') }}"
    :aria-expanded="open"
    @click="open = !open"
    class="flex items-center justify-center cursor-pointer rounded-control transition-colors duration-150 {{ $props.get('triggerClass') || '' }}"
    :class="{ 'bg-primary/15 ring-1 ring-primary/40': open }"
  >
    {{{ await $slots.trigger() }}}
  </button>

  <div
    x-show="open"
    style="display: none"
    class="absolute top-full mt-3 w-46 p-2 bg-card text-foreground border rounded-control shadow-md z-50 {{ $props.get('align') === 'left' ? 'left-0' : 'right-0' }}"
  >
    {{{ await $slots.main() }}}
  </div>
</div>