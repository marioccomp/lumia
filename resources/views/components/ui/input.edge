<div class="flex flex-col gap-1.5 w-full">
  @field.root({ name, id })
    @if(label)
      @!field.label({
        text: label ?? '',
        class: 'text-muted-foreground text-sm font-[400]',
      })
    @end

    <div class="relative w-full">
      @if(icon)
        <span
          class="{{ icon }} absolute left-3 top-1/2 -translate-y-1/2 size-4 text-muted-foreground pointer-events-none"
        ></span>
      @end
      @if(multiline)
        @!textarea.control({
          ...$props
            .except([
              'name',
              'id',
              'label',
              'icon',
              'class',
              'type',
              'multiline',
            ])
            .all(),
          rows: rows ?? 4,
          class: `bg-surface rounded-[10px] w-full py-[12px] border-1 px-[10px] resize-none ${icon ? 'pl-8.5 pr-3' : ''}`,
          placeholder: placeholder,
        })
      @else
        @!input.control({
          ...$props
            .except(['name', 'id', 'label', 'icon', 'class', 'type', 'multiline'])
            .all(),
          type: type ?? 'text',
          class: `bg-surface rounded-[10px] w-full py-[12px] border-1 ${icon ? 'pl-8.5 pr-3' : 'px-[10px]'}`,
          placeholder: placeholder,
          footerText: footerText || null,
        })
      @end
      @!field.error()
    </div>
  @end
</div>
