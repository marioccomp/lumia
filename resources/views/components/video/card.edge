<main
  data-card
  data-video-id="{{ id }}"
  class=" relative flex flex-col border-1 p-2 pb-3 rounded-2xl gap-2.5"
>
  <ul
    data-menu
    class="absolute right-2 top-11 z-20 w-60 py-1.5 bg-card text-foreground border border-border rounded-xl shadow-lg text-sm hidden"
  >
    <li
      class="px-4 py-2 hover:bg-surface cursor-pointer"
      onclick="openEditModal(event, {{ id }})"
    >
      Editar detalhes
    </li>
    <li class="px-4 py-2 hover:bg-surface cursor-pointer">Alterar miniatura</li>
    <li class="px-4 py-2 hover:bg-surface cursor-pointer">Copiar link</li>
    <li class="px-4 py-2 hover:bg-surface cursor-pointer">Tornar não listado</li>
    <li
      class="px-4 py-2 hover:bg-surface cursor-pointer"
      onclick="openDeleteModal(event, {{ id }})"
    >
      Excluir vídeo
    </li>
  </ul>
  <div class="relative bg-surface rounded-[10px] overflow-hidden aspect-video">
    <img
      class="w-full h-full object-cover "
      src="https://m.media-amazon.com/images/I/71Tf4-kJHhL._UF1000,1000_QL80_.jpg"
      alt=""
    />
    @if(course)
      <p class="absolute top-2 left-2">Curso</p>
      <p class="text-center">60%</p>
    @end

    <div
      class="absolute top-2 right-2 bg-black/55 rounded-lg flex flex-col items-center justify-center max-w-[20px] max-h-[20px] w-full h-full"
    >
      <p
        class="text-center text-white icon-[lucide--ellipsis-vertical] cursor-pointer"
        onclick="details(event, this)"
      ></p>
    </div>
  </div>
  {{-- Falta adaptar a parte abaixo para cursos tambem, seguindo o que esta no figma --}}
  <div class="flex flex-col gap-[5px]">
    <h2 data-card-title class="font-semibold text-sm leading-[20px]">{{ title }}</h2>
    <div class="flex flex-col gap-[1px]">
      <p class="font-normal text-muted-foreground text-xs">{{ channel }} · {{ duration }}</p>
      <p class="font-normal text-muted-foreground text-xs">
        {{ views }}
        visualizações · há
        {{ postedAt }}
      </p>
    </div>
  </div>
</main>

<script>
  function openDeleteModal(e, videoId) {
    e.preventDefault();
    confirmModal({
      title: 'Excluir vídeo?',
      description: 'Essa ação não pode ser desfeita.',
      buttonText: 'Excluir vídeo',
      onConfirm: () => deleteVideo(videoId),
    });
  }

  async function deleteVideo(videoId) {
    const csrf = document.querySelector('meta[name="csrf-token"]').content;
    const response = await fetch(`/videos/${videoId}`, {
      method: 'DELETE',
      headers: { 'X-CSRF-TOKEN': csrf },
    });

    if (!response.ok) {
      alert('Não foi possível excluir o vídeo');
      return;
    }

    document.querySelector(`[data-card][data-video-id="${videoId}"]`)?.closest('a')?.remove();
  }

  function openEditModal(e, videoId) {
    e.preventDefault();
    const currentTitle = document
      .querySelector(`[data-card][data-video-id="${videoId}"] [data-card-title]`)
      .textContent.trim();
    confirmModal({
      title: 'Editar detalhes',
      buttonText: 'Salvar',
      fields: [
        { name: 'title', label: 'Titulo', value: currentTitle, required: true },
        { name: 'description', label: 'Descrição', placeholder: 'Opcional' },
      ],
      onConfirm: (data) => editVideo(videoId, data),
    });
  }

  async function editVideo(videoId, data) {
    const csrf = document.querySelector('meta[name="csrf-token"]').content;
    const response = await fetch(`/videos/${videoId}`, {
      method: 'PUT',
      headers: { 'X-CSRF-TOKEN': csrf, 'Content-Type': 'application/json' },
      body: JSON.stringify(data),
    });
    if (!response.ok) {
      const body = await response.json().catch(() => null);
      return alert(body?.errors?.[0]?.message ?? 'Não foi possível editar o vídeo');
    }

    document.querySelector(`[data-card][data-video-id="${videoId}"] [data-card-title]`).textContent =
      data.title;
  }

  function details(e, button) {
    e.preventDefault();
    e.stopPropagation();
    const menu = button.closest('[data-card]').querySelector('[data-menu]');
    closeMenus(menu);
    menu.classList.toggle('hidden');
  }

  function closeMenus(except) {
    document.querySelectorAll('[data-menu]').forEach((menu) => {
      if (menu !== except) menu.classList.add('hidden');
    });
  }

  document.addEventListener('click', (e) => {
    if (e.target.closest('[data-menu]')) return;
    closeMenus();
  });
</script>
