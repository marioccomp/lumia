@layout()
  <section class="mx-auto flex w-full flex-col gap-6">
    <header class="flex flex-col gap-1">
      <h1 class="text-2xl font-semibold">Editar canal</h1>

      <p class="text-sm text-muted-foreground">
        Atualize as informações que aparecem no seu canal.
      </p>
    </header>
    @form({
      route: 'channels.update',
      enctype: 'multipart/form-data',
      class:
        'mx-auto w-full max-w-7xl overflow-hidden rounded-card border border-border bg-card',
      'x-data':
        '{ arquivoCapa: null, previaCapaUrl: null, arquivoFoto: null, previaFotoUrl: null }',
    })
      <div class="relative h-36 overflow-hidden bg-linear-to-r from-primary/35 to-primary sm:h-44">
        <input
          type="file"
          name="cover"
          accept="image/jpeg,image/png,image/webp"
          class="sr-only"
          aria-label="Selecionar capa"
          x-ref="capaInput"
          @change="
            if (previaCapaUrl) {
            URL.revokeObjectURL(previaCapaUrl)
            }

            arquivoCapa = $event.target.files[0] ?? null
            previaCapaUrl = arquivoCapa
            ? URL.createObjectURL(arquivoCapa)
            : null
            "
        />
        @if(coverUrl)
          <img
            src="{{ coverUrl }}"
            alt="Capa atual do canal"
            x-show="!previaCapaUrl"
            class="absolute inset-0 size-full object-cover"
          />
        @end

        <template x-if="previaCapaUrl">
          <img
            :src="previaCapaUrl"
            alt="Prévia da capa do canal"
            class="absolute inset-0 size-full object-cover"
          />
        </template>
        @!ui.button({
          text: 'Editar capa',
          type: 'button',
          variant: 'secondary',
          class: 'absolute bottom-4 right-4 z-10 text-sm',
          '@click': '$refs.capaInput.click()',
        })
      </div>

      <div class="flex flex-col gap-6 p-6">
        <div class="flex items-center gap-4">
          <input
            type="file"
            name="avatar"
            accept="image/jpeg,image/png,image/webp"
            class="sr-only"
            aria-label="Selecionar foto do canal"
            x-ref="fotoInput"
            @change="
              if (previaFotoUrl) {
              URL.revokeObjectURL(previaFotoUrl)
              }

              arquivoFoto = $event.target.files[0] ?? null
              previaFotoUrl = arquivoFoto ? URL.createObjectURL(arquivoFoto) : null
              "
          />
          @button({
            type: 'button',
            class: 'group relative size-16 shrink-0 cursor-pointer rounded-full',
            'aria-label': 'Alterar foto do canal',
            '@click': '$refs.fotoInput.click()',
          })
            @!avatar({
              initials: channelUser.initials,
              src: avatarUrl,
              alt: 'Foto do canal',
              'x-show': '!previaFotoUrl',
              class:
                'size-16 rounded-full bg-primary text-primary-foreground flex items-center justify-center text-xl font-semibold object-cover',
            })

            <template x-if="previaFotoUrl">
              <img
                :src="previaFotoUrl"
                alt="Prévia da foto do canal"
                class="absolute inset-0 size-full rounded-full object-cover"
              />
            </template>

            <span
              aria-hidden="true"
              class="pointer-events-none absolute inset-0 flex items-center justify-center rounded-full bg-black/60 px-2 text-center text-xs font-medium leading-tight text-white opacity-0 transition-opacity duration-150 group-hover:opacity-100 group-focus-visible:opacity-100"
            >
              Mudar foto
            </span>

            <span class="absolute bottom-0 right-0 rounded-full border border-border bg-card p-1">
              <span class="block size-3 icon-[lucide--camera]" aria-hidden="true"></span>
            </span>
          @end

          <div>
            <h2 class="text-sm font-small">Foto do canal</h2>
          </div>
        </div>
        @!ui.input({
          name: 'fullName',
          label: 'Nome de exibição',
          value: channelUser.fullName || '',
          maxlength: 50,
          autocomplete: 'name',
          footerText: 'Aparece no seu canal e nos comentários.',
        })
        @!ui.input({
          name: 'username',
          label: 'Nome de usuário',
          value: channelUser.username || '',
          maxlength: 30,
          footerText: 'Digite sem o @. Exemplo: lucas_santiago.',
        })
        @!ui.input({
          name: 'bio',
          label: 'Bio',
          value: channelUser.bio || '',
          multiline: true,
          rows: 4,
          maxlength: 300,
          placeholder: 'Conte o que as pessoas encontram no seu canal.',
        })
        @let(savedLinks = channelUser.links.map((link) => ({
          type: link.type,
          title: link.type === 'outro' ? link.title : '',
          url: link.url,
        })))
        @let(restoredLinks = flashMessages.get('input.links', []))
        @let(initialLinks = flashMessages.has('input')
          ? Array.isArray(restoredLinks)
            ? restoredLinks
            : []
          : savedLinks)
        @let(linkErrors = Object.entries(flashMessages.get('inputErrorsBag', {}))
          .filter((entry) => entry[0] === 'links' || entry[0].startsWith('links.'))
          .flatMap((entry) => entry[1]))
        @let(linkControlClass =
          'w-full rounded-control border border-border bg-surface px-3 py-2 text-sm')

        <section
          class="flex flex-col gap-4 border-t border-border pt-6"
          x-data="{
            links: {{ JSON.stringify(initialLinks) }}.map((link, key) => ({ ...link, key })),
            nextKey: {{ initialLinks.length }},
            adicionarLink() {
            if (this.links.length >= 5) return
            this.links.push({ key: this.nextKey++, type: 'site', title: '', url: '' })
            }
            }"
        >
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
              <h2 class="text-sm font-semibold">Links do canal</h2>
              <p class="text-xs text-muted-foreground">
                Divulgue suas redes sociais, sites e outros conteúdos.
              </p>
            </div>
            @!ui.button({
              text: 'Adicionar link',
              type: 'button',
              variant: 'secondary',
              '@click': 'adicionarLink()',
              ':disabled': 'links.length >= 5',
              class: 'text-sm disabled:cursor-not-allowed disabled:opacity-50',
            })
          </div>
          @if(linkErrors.length)
            <ul role="alert" class="space-y-1 text-sm text-red-500">
              @each(message in linkErrors)
                <li>{{ message }}</li>
              @end
            </ul>
          @end

          <p x-show="links.length === 0" class="text-sm text-muted-foreground">
            Nenhum link adicionado.
          </p>

          <template x-for="(link, index) in links" :key="link.key">
            <div
              class="grid grid-cols-[minmax(0,1fr)_auto] items-start gap-2 sm:grid-cols-[9rem_minmax(0,1fr)_auto]"
            >
              <div class="col-span-2 sm:col-span-1" x-data="{}">
                @field.root({ name: 'channel-link-type' })
                  @!field.label({
                    text: 'Tipo do link',
                    ':for': "'link-type-' + link.key",
                    class: 'sr-only',
                  })
                  @!select.control({
                    'x-model': 'link.type',
                    'x-ref': 'tipoLink',
                    'x-show': "link.type !== 'outro'",
                    '@change':
                      "if ($event.target.value === 'outro') $nextTick(() => requestAnimationFrame(() => $refs.nomePersonalizado.focus()))",
                    ':id': "'link-type-' + link.key",
                    ':name': "'links[' + index + '][type]'",
                    required: true,
                    class: linkControlClass,
                    options: [
                      { value: 'site', name: 'Site' },
                      { value: 'linkedin', name: 'LinkedIn' },
                      { value: 'github', name: 'GitHub' },
                      { value: 'instagram', name: 'Instagram' },
                      { value: 'youtube', name: 'YouTube' },
                      { value: 'outro', name: 'Outro' },
                    ],
                  })
                @end

                <div x-show="link.type === 'outro'" class="relative">
                  @field.root({ name: 'channel-link-title' })
                    @!field.label({
                      text: 'Nome personalizado do link',
                      ':for': "'link-title-' + link.key",
                      class: 'sr-only',
                    })
                    @!input.control({
                      type: 'text',
                      maxlength: 50,
                      placeholder: 'Nome do link',
                      'x-ref': 'nomePersonalizado',
                      'x-model': 'link.title',
                      ':id': "'link-title-' + link.key",
                      ':name': "'links[' + index + '][title]'",
                      ':required': "link.type === 'outro'",
                      ':disabled': "link.type !== 'outro'",
                      class: linkControlClass + ' pr-8',
                    })
                  @end
                  @button({
                    type: 'button',
                    'aria-label': 'Alterar tipo do link',
                    title: 'Alterar tipo',
                    '@click':
                      "link.type = 'site'; $nextTick(() => requestAnimationFrame(() => $refs.tipoLink.focus()))",
                    class:
                      'absolute inset-y-0 right-1 my-auto inline-flex size-6 cursor-pointer items-center justify-center rounded text-muted-foreground hover:bg-border',
                  })
                    <span class="size-3.5 icon-[lucide--chevron-down]" aria-hidden="true"></span>
                  @end
                </div>
              </div>

              <div class="min-w-0">
                @field.root({ name: 'channel-link-url' })
                  @!field.label({
                    text: 'Endereço do link',
                    ':for': "'link-url-' + link.key",
                    class: 'sr-only',
                  })
                  @!input.control({
                    type: 'url',
                    maxlength: 2048,
                    placeholder: 'https://exemplo.com',
                    required: true,
                    'x-model': 'link.url',
                    ':id': "'link-url-' + link.key",
                    ':name': "'links[' + index + '][url]'",
                    class: linkControlClass,
                  })
                @end
              </div>
              @button({
                type: 'button',
                'aria-label': 'Remover link',
                title: 'Remover link',
                '@click': 'links.splice(index, 1)',
                class:
                  'inline-flex size-10 cursor-pointer items-center justify-center rounded-control text-muted-foreground transition-colors hover:bg-surface hover:text-red-500',
              })
                <span class="size-4 icon-[lucide--x]" aria-hidden="true"></span>
              @end
            </div>
          </template>
        </section>
      </div>

      <footer class="border-t border-border p-6">
        @field.root({ name: 'cover' })
          @!field.error({ class: 'mb-3 text-sm text-red-500' })
        @end
        @field.root({ name: 'avatar' })
          @!field.error({ class: 'mb-3 text-sm text-red-500' })
        @end

        <div class="flex flex-wrap items-center justify-end gap-3">
          @!link({
            route: 'channels.me',
            text: 'Cancelar',
            class:
              'inline-flex items-center justify-center rounded-control px-4 py-2 text-sm transition-colors hover:bg-surface',
          })
          @!ui.button({
            text: 'Salvar alterações',
            type: 'submit',
            variant: 'primary',
            class: 'text-sm font-medium',
          })
        </div>
      </footer>
    @end
  </section>
@end
