@layout()
  <div class="explore-page">
    @if(auth.user)
      <section class="continue-assistindo">
        <div class="section-header">
          <h2>Continue assistindo</h2>
          <a href="/videos">Ver todos</a>
        </div>

        <div class="grid gap-4 grid-cols-[repeat(auto-fill,minmax(320px,1fr))]">
          @!video.card({
            title: 'Como programar em JavaScript',
            channel: 'Canal do Guinho',
            views: '12 mil',
            duration: '12:34',
            postedAt: '3 dias',
          })
          @!video.card({
            title: 'Como programar em JavaScript',
            channel: 'Canal do Guinho',
            views: '12 mil',
            duration: '12:34',
            postedAt: '3 dias',
          })
        </div>
      </section>
    @end

    <section class="view-videos">
      <div class="section-header">
        <h2>Video que podem te interessar</h2>
        <a href="/videos">Ver todos</a>
      </div>

      <div class="grid gap-4 grid-cols-[repeat(auto-fill,minmax(320px,1fr))]">
        @each(video in videos)
          <a href="{{ route('videos.show', { id: video.id }) }}">
            @!video.card({
              id: video.id,
              title: video.title,
              thumbnailUrl: video.thumbnailUrl,
              channel: 'Testando',
              views: video.views,
              duration: '12:34',
              postedAt: '5 dias',
            })
          </a>
        @end
      </div>
    </section>

    <section class="view-cursos">
      <div class="section-header">
        <h2>Cursos que você pode gostar</h2>
        <a href="/cursos">Ver todos</a>
      </div>

      <div class="grid gap-4 grid-cols-[repeat(auto-fill,minmax(320px,1fr))]">
        @!video.card({
          title: 'Como programar em JavaScript',
          channel: 'Canal do Guinho',
          views: '12 mil',
          duration: '12:34',
          postedAt: '3 dias',
        })
        @!video.card({
          title: 'Como programar em JavaScript',
          channel: 'Canal do Guinho',
          views: '12 mil',
          duration: '12:34',
          postedAt: '3 dias',
        })
      </div>
    </section>
  </div>
@end
