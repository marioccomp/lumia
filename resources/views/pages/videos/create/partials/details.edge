<div class="flex flex-col gap-[10px]" id="step-details">
  <div>
    <form method="POST" id="details-form" class="flex flex-col gap-5">
      {{ csrfField() }}
      @!ui.input({
        label: 'Título',
        placeholder: 'Dê um título ao seu vídeo',
        footerText: 'Mínimo 3 caracteres · 0/50',
        name: 'title',
      })
      @!ui.input({
        label: 'Descrição',
        placeholder: 'Conte do que se trata o vídeo...',
        footerText: 'Opcional · 0/250',
        name: 'description',
      })

      <select name="courseId">
        <option value="default" selected>Nenhum — vídeo avulso</option>
      </select>
      @!ui.input({
        type: 'radio',
        id: 'public',
        name: 'visibility',
        value: 'public',
        label: 'Público',
        checked: true,
      })
      @!ui.input({
        type: 'radio',
        id: 'unlisted',
        name: 'visibility',
        value: 'unlisted',
        label: 'Não listado',
      })
      @!ui.input({
        type: 'radio',
        id: 'private',
        name: 'visibility',
        value: 'private',
        label: 'Privado',
      })
      @!ui.button({
        text: 'Salvar e continuar',
        type: 'submit',
      })
    </form>
  </div>
</div>
