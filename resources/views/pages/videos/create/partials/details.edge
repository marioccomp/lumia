<div class="flex flex-col gap-[10px] hidden" id="step-details">
  @!video.header({
    title: 'Detalhes do vídeo',
  })

  <ul class="flex gap-[10px]">
    <li class="text-xs leading-[15px] py-[6px] px-[12px] bg-surface border rounded-full">
      1. Arquivo
    </li>
    <li
      class="text-xs leading-[15px] py-[6px] px-[12px] bg-surface border border-ring rounded-full"
    >
      2. Detalhes
    </li>
    <li class="text-xs leading-[15px] py-[6px] px-[12px] bg-surface border rounded-full">
      3. Publicação
    </li>
  </ul>

  <div>
    <form method="POST" id="details-form" class="flex flex-col gap-5">
      {{ csrfField() }}
      @!ui.input({
        label: 'Título',
        placeholder: 'Dê um título ao seu vídeo',
        footerText: 'Mínimo 3 caracteres · 0/100',
        name: 'title',
      })
      @!ui.input({
        label: 'Descrição',
        placeholder: 'Conte do que se trata o vídeo...',
        footerText: 'Opcional · 0/5000',
        name: 'description',
      })

      <select name="courseId">
        <option value="default" selected>Nenhum — vídeo avulso</option>
      </select>
      @!ui.input({
        type: 'radio',
        id: 'public',
        name: 'visibility',
        value: 'public',
        label: 'Público',
        checked: true,
      })
      @!ui.input({
        type: 'radio',
        id: 'unlisted',
        name: 'visibility',
        value: 'unlisted',
        label: 'Não listado',
      })
      @!ui.input({
        type: 'radio',
        id: 'private',
        name: 'visibility',
        value: 'private',
        label: 'Privado',
      })
      @!ui.button({
        text: 'Salvar e continuar',
        type: 'submit',
      })
    </form>
  </div>
</div>
