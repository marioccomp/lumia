@layout()
  <div class="w-full max-w-[850px] flex flex-col gap-[20px]">
    <media-player
      title="{{ video.title }}"
      src="{{ videoUrl }}"
      playsinline
      class="w-full max-w-[850px] aspect-video"
    >
      <media-provider></media-provider>
      <media-video-layout></media-video-layout>
    </media-player>

    <p class="font-semibold text-[22px] text-foreground">{{ video.title }}</p>
    <div class="flex justify-between">
      <div class="flex items-center gap-[12px]">
        @!avatar({
          initials: 'MJ',
          class:
            'cursor-pointer bg-primary rounded-2xl w-[30px] h-[30px] text-primary-foreground flex justify-center items-center font-[600] text-xs',
        })
        <div>
          <p class="font-semibold text-sm text-foreground">Mario Junior</p>
          <p class="text-xs font-normal text-muted-foreground">24,3 mil inscritos</p>
        </div>
        @!ui.button({
          text: 'Inscrever-se',
          class: 'px-[20px] py-[10px]',
        })
      </div>

      <div class="flex border w-full max-w-[320px] items-center justify-center px-4 relative">
        <p
          class="cursor-pointer text-foreground font-medium text-[13px] w-full max-w-[33%] py-3 flex items-center gap-1"
        >
          <span class="icon-[lucide--thumbs-up]"></span>
          1,2 mil
        </p>
        <span class="icon-[lucide--tally-1] absolute left-[28.75%]"></span>

        <p
          class="cursor-pointer  text-foreground font-medium text-[13px] w-full max-w-[33%] py-3 flex items-center gap-1"
        >
          <span class="icon-[lucide--save]"></span>
          Salvar
        </p>
        <span class="icon-[lucide--tally-1] absolute right-[35.75%]"></span>

        <p
          class="cursor-pointer  text-foreground font-medium text-[13px] w-full max-w-[33%] py-3 flex items-center gap-1"
        >
          <span class="icon-[lucide--share]"></span>
          Compartilhar
        </p>
      </div>
    </div>

    <div class="flex flex-col p-[16px] gap-[8px] bg-surface rounded-xl w-full">
      <div>
        <p class="font-medium text-muted-foreground text-xs">12 mil visualizações · há 3 dias</p>
      </div>

      <p class="text-foreground font-normal text-sm">{{ video.description }}</p>
    </div>
    <div>
      @form({
        method: 'POST',
        action: `/videos/${video.id}/comments`,
        class: 'flex flex-col gap-2 w-full',
      })
        <h3 class="text-foreground font-semibold text-base">{{ comments.length }} comentários</h3>
        <div class="flex flex-col gap-2">
          <div class="flex gap-4 items-center">
            @!avatar({
              initials: 'MJ',
              class:
                'cursor-pointer bg-primary rounded-2xl w-[30px] h-[30px] text-primary-foreground flex justify-center items-center font-[600] text-xs',
            })
            @!ui.input({
              name: 'text',
              label: 'Comentário',
              multiline: true,
              rows: 1,
            })
          </div>
          @!ui.button({
            text: 'Enviar',
            type: 'submit',
            class: 'self-end',
          })
        </div>
      @end

      <div class="flex flex-col gap-4 mt-4">
        @each(comment in comments)
          <div class="flex gap-[12px] items-start">
            @!avatar({
              initials: 'MJ',
              class:
                'cursor-pointer bg-primary rounded-2xl w-[30px] h-[30px] text-primary-foreground flex justify-center items-center font-[600] text-xs',
            })
            <div class="flex flex-col gap-[3px]">
              <div class="flex gap-2 items-center">
                <p class="text-semibold text-13px text-foreground">{{ comment.user.fullName }}</p>
                <p class="text-[11.5px] text-muted-foreground font-normal">
                  {{ comment.createdAt.toRelative() }}
                </p>
              </div>

              <p class="text-foreground font-normal text-[13.5px] leading-[20px]">
                {{ comment.text }}
              </p>
              <div class="flex gap-3">
                <p class="text-muted-foreground text-[11.5px] font-medium flex gap-2 items-center">
                  <span class="cursor-pointer icon-[lucide--thumbs-up]"></span>24
                </p>
                <p class="text-muted-foreground text-[11.5px] font-medium cursor-pointer">
                  Responder
                </p>
              </div>
            </div>
          </div>
        @else
          <p>Nenhum comentário ainda</p>
        @end
      </div>
    </div>
  </div>
@end
