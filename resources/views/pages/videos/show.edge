@layout()
  <p>abaixo seguem informações do video</p>
  <p>{{ video.title }}</p>
  <p>{{ video.description || 'Sem descrição' }}</p>

  <media-player
    title="{{ video.title }}"
    src="{{ videoUrl }}"
    playsinline
    class="w-full max-w-[850px] aspect-video"
  >
    <media-provider></media-provider>
    <media-video-layout></media-video-layout>
  </media-player>
  @form({
    method: 'POST',
    action: `/videos/${video.id}/comments`,
    class: 'flex flex-col gap-2 max-w-[50%] w-full',
  })
    <h3>Abaixo você pode comentar</h3>
    @!ui.input({
      name: 'text',
      label: 'Faça um comentário',
      multiline: true,
      rows: 5,
    })
    @!ui.button({
      text: ' Enviar comentário',
      type: 'submit',
    })
  @end

  <div class="flex flex-col gap-4 mt-4">
    @each(comment in comments)
      <div>
        <p class="text-bold">{{ comment.user.fullName }}</p>
        <p>{{ comment.text }}</p>
        <p class="text-sm">{{ comment.createdAt.toRelative() }}</p>
      </div>
    @else
      <p>Nenhum comentário ainda</p>
    @end
  </div>
@end
