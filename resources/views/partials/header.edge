<header class="bg-background px-10 py-5 border-b">
  <div class="flex items-center gap-[32px]">
    <div class="shrink-0 flex">
      @link({ route: 'home', text: 'Home' })
        @!brand()
        {{--
          <svg
          width="auto"
          height="18"
          viewBox="0 0 413 38"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          >
          <path
          d="M382.5 37.5v-30h7.5V0h15v7.5h7.5v30H405v-15h-15v15h-7.5ZM390 15h15V7.8h-15V15ZM360 37.5V0h7.5v37.5H360ZM315 37.5V0h22.5v7.5h7.5V30h-7.5v7.5H315Zm7.5-7.5h14.7V7.5h-14.7V30ZM277.5 37.5V0H300v7.5h-15V15h15v7.5h-15V30h15v7.5h-22.5ZM225 37.5V0h7.5v7.5h7.5V15h7.5v7.5H240V15h-7.5v22.5H225Zm30 0V15h-7.5V7.5h7.5V0h7.5v37.5H255ZM180 37.5V0h22.5v7.5h7.5V15h-7.5v15h7.5v7.5h-7.5V30H195v-7.5h-7.5v15H180Zm7.5-22.5h14.7V7.5h-14.7V15ZM142.5 37.5V0H165v7.5h-15V15h15v7.5h-15V30h15v7.5h-22.5ZM97.5 37.5V0H120v7.5h7.5V15H120v7.5h-15v15h-7.5ZM105 15h14.7V7.5H105V15ZM60 37.5V15h-7.5V7.5H45V0h7.5v7.5H60V15h7.5v22.5H60Zm15-30V0h7.5v7.5H75ZM67.5 15V7.5H75V15h-7.5ZM0 37.5V0h7.5v15h15V0H30v37.5h-7.5v-15h-15v15H0Z"
          fill="currentColor"
          />
          </svg>
        --}}
      @end
    </div>
    <ul class="flex gap-8">
      <li>
        @!ui.navLink({
          href: '/',
          text: 'Explorar',
        })
      </li>
      <li>
        @!ui.navLink({
          href: '/videos',
          text: 'Videos',
        })
      </li>
      <li>
        @!ui.navLink({
          href: '/cursos',
          text: 'Cursos',
        })
      </li>
    </ul>
    @form({
      class: 'relative flex-1 min-w-0 max-w-md ',
    })
      @!ui.input({
        type: 'search',
        name: 'search',
        placeholder: 'Buscar',
        icon: 'icon-[lucide--search]',
      })
    @end

    <nav class="flex items-center gap-5 shrink-0 ml-auto">
      <button
        type="button"
        x-data
        @click="$store.theme.toggle()"
        class="cursor-pointer text-lg px-2 py-1 text-muted-foreground "
        aria-label="Alternar tema"
      >
        <span
          :class="$store.theme.dark ? 'icon-[lucide--sun]' : 'icon-[lucide--moon]'"
          class="size-5 block"
        ></span>
      </button>
      @if(auth.user)
        @!avatar({ initials: auth.user.initials })
        @form({ route: 'session.destroy', method: 'POST' })
          @!button({ text: 'Logout' })
        @end
      @else
        @!link({
          route: 'session.create',
          text: 'Entrar',
          class: 'text-base font-medium text-foreground transition-colors',
        })
        @!link({
          route: 'new_account.create',
          text: 'Criar conta',
          class:
            'text-base font-medium rounded-xl px-6 py-3 bg-primary text-primary-foreground transition-colors',
        })
      @end
    </nav>
  </div>
</header>
